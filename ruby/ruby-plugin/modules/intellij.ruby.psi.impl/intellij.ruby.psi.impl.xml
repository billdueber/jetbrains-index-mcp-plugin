<idea-plugin visibility="public">
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.ruby.impl"/>
    <module name="intellij.ruby.psi"/>
    <!-- endregion -->
  </dependencies>
  <extensionPoints>
    <extensionPoint qualifiedName="org.jetbrains.plugins.ruby.callTypeProvider"
                    interface="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.RubyCallTypeProvider"
                    dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <lang.parserDefinition language="ruby" implementationClass="org.jetbrains.plugins.ruby.ruby.lang.parser.RubyParserDefinition"/>
    <lang.parserDefinition language="rbenv-gemsets"
                           implementationClass="org.jetbrains.plugins.ruby.version.management.rbenv.gemsets.RbenvParserDefinition"/>

    <!-- ERB -->
    <lang.parserDefinition language="ERB" implementationClass="org.jetbrains.plugins.ruby.erb.parser.ErbParserDefinition"/>
    <lang.parserDefinition language="ErbRuby" implementationClass="org.jetbrains.plugins.ruby.erb.ruby.ErbRubyParserDefinition"/>
    <lang.fileViewProviderFactory language="ERB" implementationClass="org.jetbrains.plugins.ruby.erb.ErbFileViewProviderFactory"/>
    <lang.ast.factory language="ERB" implementationClass="org.jetbrains.plugins.ruby.erb.psi.impl.ErbASTFactory"/>
    <!-- END of ERB -->
    <applicationSettings service="org.jetbrains.plugins.ruby.ruby.settings.RubyLanguageSettings"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <psiElementFactory id="rubyPsiElementFactory" implementation="org.jetbrains.plugins.ruby.ruby.lang.parser.RubyPsiElementFactory"/>
  </extensions>
</idea-plugin>