<idea-plugin visibility="internal">
  <dependencies>
    <module name="intellij.ruby.psi.impl"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="RBS" language="ruby.rbs" fieldName="INSTANCE" extensions="rbs"
              implementationClass="com.intellij.ruby.rbs.common.RbsFileType"/>
    <stubElementTypeHolder class="com.intellij.ruby.rbs.common.psi.tree.RbsElementTypesGenerated" externalIdPrefix="rbs."/>

    <lang.parserDefinition language="ruby.rbs" implementationClass="com.intellij.ruby.rbs.common.psi.RbsParserDefinition"/>

    <lang.syntaxHighlighter language="ruby.rbs" implementationClass="com.intellij.ruby.rbs.common.editor.RbsSyntaxHighlighter"/>

    <codeBlockSupportHandler language="ruby.rbs" implementationClass="com.intellij.ruby.rbs.common.editor.RbsCodeBlockSupportHandler"/>
    <lang.braceMatcher language="ruby.rbs" implementationClass="com.intellij.ruby.rbs.common.editor.RbsBraceMatcher"/>

    <lang.commenter language="ruby.rbs" implementationClass="com.intellij.ruby.rbs.common.lang.commenter.RbsCommenter"/>

    <cacheBuilder fileType="RBS" wordsScannerClass="com.intellij.ruby.rbs.common.lang.RbsWordsScanner"/>

    <lang.quoteHandler language="ruby.rbs" implementationClass="com.intellij.ruby.rbs.common.editor.RbsQuoteHandler"/>
    <backspaceHandlerDelegate implementation="com.intellij.ruby.rbs.common.editor.RbsQuoteBackspaceHandler"/>
    <backspaceHandlerDelegate implementation="com.intellij.ruby.rbs.common.editor.RbsBackspaceCommentHandler"/>
    <enterHandlerDelegate implementation="com.intellij.ruby.rbs.common.editor.RbsEnterCommentHandler"/>
    <editorActionHandler action="EditorStartNewLine" id="RbsShiftEnterCommentHandler" order="first"
                         implementationClass="com.intellij.ruby.rbs.common.editor.RbsEnterCommentHandler$RbsShiftEnterCommentHandler"/>
    <enterHandlerDelegate implementation="com.intellij.ruby.rbs.common.editor.RbsEndInsertHandler"/>
    <typedHandler implementation="com.intellij.ruby.rbs.common.editor.RbsEndTypedHandler"/>
    <typedHandler implementation="com.intellij.ruby.rbs.common.editor.RbsSpaceTypedHandler"/>
    <typedHandler implementation="com.intellij.ruby.rbs.common.editor.RbsColonTypedHandler"/>
    <typedHandler implementation="com.intellij.ruby.rbs.common.editor.RbsQuoteTypedHandler" order="last"/>

    <langCodeStyleSettingsProvider implementation="com.intellij.ruby.rbs.common.lang.formatter.RbsCodeStyleSettingsProvider"/>
    <lang.formatter language="ruby.rbs" implementationClass="com.intellij.ruby.rbs.common.formatter.RbsFormattingModelBuilder"/>
    <fileIndentOptionsProvider implementation="com.intellij.ruby.rbs.common.formatter.RbsFileIndentOptionProvider"/>
  </extensions>
</idea-plugin>