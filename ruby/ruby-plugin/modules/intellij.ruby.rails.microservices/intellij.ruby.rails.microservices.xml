<idea-plugin>
  <dependencies>
    <module name="intellij.ruby.backend"/>
    <module name="intellij.microservices.backend"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <microservices.endpointsProvider implementation="org.jetbrains.plugins.ruby.rails.microservices.endpoints.RailsEndpointsProvider"/>
    <microservices.urlInlayAction implementation="org.jetbrains.plugins.ruby.rails.microservices.url.inlay.RailsGoToRouteUrlPathInlayAction" order="first"/>
    <microservices.urlInlayLanguagesProvider implementation="org.jetbrains.plugins.ruby.rails.microservices.codeInsight.hints.RailsRouteUrlPathHintsProvider"/>
    <microservices.urlResolverFactory implementation="org.jetbrains.plugins.ruby.rails.microservices.url.RailsRouteUrlResolverFactory"/>

    <semContributor implementation="org.jetbrains.plugins.ruby.rails.microservices.codeInsight.hints.RailsRouteUrlPathHintSemContributor"/>
  </extensions>
</idea-plugin>
