<idea-plugin visibility="internal">
  <dependencies>
    <module name="intellij.platform.langInjection"/>
    <module name="intellij.ruby.common"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <languageInjectionPerformer language="ruby"
                                implementationClass="org.jetbrains.plugins.ruby.ruby.intelliLang.RubyLanguageInjectionPerformer"/>
  </extensions>

  <extensions defaultExtensionNs="org.intellij.intelliLang">
    <injectionConfig config="injections/rubyHeredocInjections.xml"/>
    <injectionConfig config="injections/rubyParamDefInjections.xml"/>

    <languageSupport implementation="org.jetbrains.plugins.ruby.ruby.intelliLang.RubyLanguageInjectionSupport"/>
  </extensions>
</idea-plugin>