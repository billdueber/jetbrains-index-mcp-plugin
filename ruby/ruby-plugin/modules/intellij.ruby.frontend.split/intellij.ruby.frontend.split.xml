<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.jetbrains.client"/>
    <module name="intellij.platform.frontend.split"/>
    <module name="intellij.rd.client"/>
    <module name="intellij.ruby.frontend"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <applicationService
      serviceImplementation="org.jetbrains.plugins.ruby.ruby.codeInsight.types.RTypeUtilFrontendService"
      serviceInterface="org.jetbrains.plugins.ruby.ruby.codeInsight.types.RTypeUtilService"/>
    <applicationService
      serviceImplementation="org.jetbrains.plugins.ruby.rdoc.yard.YARDFrontendService"
      serviceInterface="org.jetbrains.plugins.ruby.rdoc.yard.YARDService"/>
    <applicationService
      serviceImplementation="org.jetbrains.plugins.ruby.ruby.lang.psi.RubyPsiPresentationFrontendService"
      serviceInterface="org.jetbrains.plugins.ruby.ruby.lang.psi.RubyPsiPresentationService"/>
    <applicationService
      serviceImplementation="org.jetbrains.plugins.ruby.ruby.codeInsight.symbolicExecution.summary.SummaryUtilFrontendService"
      serviceInterface="org.jetbrains.plugins.ruby.ruby.codeInsight.symbolicExecution.summary.SummaryUtilService"/>
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.RubyCallTypesFrontendService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.RubyCallTypesService"/>
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.lang.psi.controlFlow.impl.RControlFlowBuilderFrontendService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.lang.psi.controlFlow.impl.RControlFlowBuilderService"/>
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.codeInsight.resolve.scope.ScopeUtilFrontendService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.codeInsight.resolve.scope.ScopeUtilService"/>
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.lang.psi.impl.holders.utils.RContainerUtilFrontendService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.lang.psi.impl.holders.utils.RContainerUtilService"/>
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.codeInsight.symbols.structure.FrontendRubySymbolUtilService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.codeInsight.symbols.structure.RubySymbolUtilService"/>
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.lang.psi.holders.RubyFrontendDocumentationSymbolsService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.lang.psi.holders.RubyDocumentationSymbolsService"/>
    <applicationService serviceImplementation="com.intellij.ruby.frontend.ruby.lang.references.RubyFrontendPsiReferencesService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.lang.references.RubyPsiReferencesService"/>
    <rdclient.editorActionHandlerStrategyCustomizer implementation="com.intellij.ruby.frontend.ruby.editor.actions.RubyEditorActionHandlerStrategyCustomizer"/>
    <registryKey key="ruby.frontend.speculative.actions.enabled" defaultValue="true"
                 description="Enable speculative actions on the client side; otherwise, they will be performed on the server side"/>
    <rdclient.actionCustomization backend="remote" actionId="CommentByBlockComment"
                                  implementationClass="com.intellij.ruby.frontend.ruby.editor.actions.RubyBackendActionCustomization"/>
    <rdclient.actionCustomization backend="remote" actionId="CommentByLineComment"
                                  implementationClass="com.intellij.ruby.frontend.ruby.editor.actions.RubyBackendActionCustomization"/>
    <rdclient.highlighterSuppressionHandler implementation="com.intellij.ruby.frontend.ruby.RubyFrontendHighlighterSuppressionHandler"/>
    <projectService serviceInterface="org.jetbrains.plugins.ruby.gem.bundler.BundleConfigService"
                    serviceImplementation="com.intellij.ruby.frontend.ruby.gem.bundler.FrontendBundleConfigService"/>
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.lang.psi.impl.RubyFrontendLanguageLevelService"
                        serviceInterface="org.jetbrains.plugins.ruby.ruby.lang.psi.impl.RubyLanguageLevelService"/>
  </extensions>

</idea-plugin>