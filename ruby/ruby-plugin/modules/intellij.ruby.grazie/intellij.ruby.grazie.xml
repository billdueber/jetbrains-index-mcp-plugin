<idea-plugin>
  <dependencies>
    <plugin id="tanvd.grazi"/>
    <module name="intellij.ruby.backend"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij.grazie">
    <textExtractor language="ruby"
                   implementationClass="com.intellij.lang.ruby.grazie.RubyTextExtractor"/>
    <problemFilter language="ruby"
                   implementationClass="com.intellij.lang.ruby.grazie.RubyGrazieProblemFilter"/>
  </extensions>
</idea-plugin>