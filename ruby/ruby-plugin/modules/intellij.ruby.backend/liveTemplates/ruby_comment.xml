<?xml version="1.0" encoding="UTF-8"?>
<templateSet group="Ruby">
  <template name="encoding" value="encoding: $ENCODING$$END$" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.ruby.encoding.description" resource-bundle="messages.RBundle">
    <variable name="ENCODING" expression="" defaultValue="&#34;utf-8&#34;" alwaysStopAt="true" />
    <context>
      <option name="RUBY_COMMENTS" value="true" />
    </context>
  </template>
  <template name="frozen_string_literal" value="frozen_string_literal: $VALUE$$END$" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.ruby.frozen_string_literal.description" resource-bundle="messages.RBundle">
    <variable name="VALUE" expression="enum(&#34;true&#34;, &#34;false&#34;)" defaultValue="&#34;true&#34;" alwaysStopAt="false"/>
    <context>
      <option name="RUBY_COMMENTS" value="true"/>
    </context>
  </template>
  <template name="warn_indent" value="warn_indent: $VALUE$$END$" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.ruby.warn_indent.description" resource-bundle="messages.RBundle">
    <variable name="VALUE" expression="enum(&#34;true&#34;, &#34;false&#34;)" defaultValue="&#34;true&#34;" alwaysStopAt="true"/>
    <context>
      <option name="RUBY_COMMENTS" value="true" />
    </context>
  </template>
</templateSet>
