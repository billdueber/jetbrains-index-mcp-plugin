<?xml version="1.0" encoding="UTF-8"?>
<templateSet group="RSpec">
  <template name="aft" value="after do&#10;  $END$&#10;end" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.aft.description" resource-bundle="messages.RBundle">
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
  <template name="aftc" value="after(:context) do&#10;  $END$&#10;end" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.aftc.description" resource-bundle="messages.RBundle">
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
  <template name="bef" value="before do&#10;  $END$&#10;end" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.bef.description" resource-bundle="messages.RBundle">
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
  <template name="befc" value="before(:context) do&#10;  $END$&#10;end" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.befc.description" resource-bundle="messages.RBundle">
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
  <template name="con" value="context '$CONTEXT$' do&#10;  $END$&#10;end" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.con.description" resource-bundle="messages.RBundle">
    <variable name="CONTEXT" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
  <template name="desc" value="describe '$OBJECT$' do&#10;  $END$&#10;end" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.desc.description" resource-bundle="messages.RBundle">
    <variable name="OBJECT" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
  <template name="it" value="it '$RESULT$' do&#10;  $END$&#10;end" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.it.description" resource-bundle="messages.RBundle">
    <variable name="RESULT" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
  <template name="its" value="it { is_expected$END$ }" toReformat="true" toShortenFQNames="true"
            key="live.templates.group.rspec.its.description" resource-bundle="messages.RBundle">
    <context>
      <option name="RSPEC" value="true"/>
    </context>
  </template>
</templateSet>
