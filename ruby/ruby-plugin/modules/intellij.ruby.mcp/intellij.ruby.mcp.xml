<idea-plugin visibility="internal">
  <dependencies>
    <module name="intellij.ruby.backend"/>
    <module name="intellij.ruby.rails.microservices"/>
    <plugin id="com.intellij.mcpServer"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <mcpServer.mcpToolset implementation="com.intellij.ruby.mcp.toolsets.RailsToolset"/>
    <statistics.counterUsagesCollector implementationClass="com.intellij.ruby.mcp.statistics.RailsMcpUsageCollector"/>
  </extensions>
</idea-plugin>
