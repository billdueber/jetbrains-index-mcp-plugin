<idea-plugin visibility="public">
  <dependencies>
    <module name="intellij.ruby.common"/>
    <module name="intellij.ruby.rbs.common"/>
    <module name="intellij.platform.backend"/>
  </dependencies>
  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <callTypeOperator forClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.StringCallType"
                      implementationClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.ParamsAsStringsOperator"/>
    <callTypeOperator forClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.EmptyCallType"
                      implementationClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.EmptyStorageOperator"/>
    <callTypeOperator forClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.FQNCallType"
                      implementationClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.FQNCallTypeStorageOperator"/>
  </extensions>
</idea-plugin>
