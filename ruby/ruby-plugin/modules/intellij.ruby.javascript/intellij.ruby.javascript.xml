<idea-plugin>
  <dependencies>
    <plugin id="JavaScript"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <plugin id="com.intellij.stimulus"/>
    <module name="intellij.javascript.parser"/>
    <module name="intellij.javascript.psi.impl"/>
    <module name="intellij.ruby.backend"/>
    <!-- endregion -->
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <!-- ERB -->

    <lang.substitutor language="JavaScript" implementationClass="com.intellij.ruby.javascript.erb.ErbJavaScriptLanguageSubstitutor"/>

    <!-- Rails Import Maps-->

    <runAnything.executionProvider
      implementation="com.intellij.ruby.javascript.rails.importmap.actions.providers.RailsImportMapRunAnythingProvider"/>

    <searcher forClass="com.intellij.find.usages.api.UsageSearchParameters"
              implementationClass="com.intellij.ruby.javascript.rails.importmap.model.usages.RailsImportMapUsageSearcher"/>

    <stubIndex implementation="com.intellij.ruby.javascript.rails.importmap.psi.indexes.RailsImportMapModuleDynamicDeclarationIndex"/>
    <stubIndex implementation="com.intellij.ruby.javascript.rails.importmap.psi.indexes.RailsImportMapModuleNameIndex"/>

    <psi.referenceContributor language="ruby" implementation="com.intellij.ruby.javascript.rails.stimulus.StimulusReferenceContributor"/>
    <psi.referenceContributor language="JavaScript" implementation="com.intellij.ruby.javascript.rails.stimulus.StimulusReferenceContributor"/>
    <referencesSearch implementation="com.intellij.ruby.javascript.rails.stimulus.StimulusReferenceSearch"/>

    <pom.declarationSearcher implementation="com.intellij.ruby.javascript.rails.stimulus.StimulusDeclarationSearcher"/>
    <renameInputValidator implementation="com.intellij.ruby.javascript.rails.stimulus.StimulusTargetRenameInputValidator" order="first"/>
    <fileBasedIndex implementation="com.intellij.ruby.javascript.rails.stimulus.StimulusControllerNameIndex"/>
    <elementDescriptionProvider implementation="com.intellij.ruby.javascript.rails.stimulus.StimulusElementDescriptionProvider"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <!-- Rails Import Maps -->
    <callTypeIndexer forClass="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RailsImportMapPinAllFromCallType"
                     implementationClass="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RailsImportMapPinAllFromCallTypeIndexer"/>
    <callTypeOperator forClass="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RailsImportMapPinAllFromCallType"
                      implementationClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.ParamsAsStringsOperator"/>
    <callTypeIndexer forClass="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RailsImportMapPinCallType"
                      implementationClass="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RailsImportMapPinCallTypeIndexer"/>
    <callTypeOperator forClass="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RailsImportMapPinCallType"
                      implementationClass="org.jetbrains.plugins.ruby.ruby.lang.psi.methodCall.ParamsAsStringsOperator"/>
    <callTypeProvider implementation="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RailsImportMapCallTypeProvider"/>
    <callTypeReferenceContributorsProvider
      implementation="com.intellij.ruby.javascript.rails.importmap.codeInsight.callTypes.RubyJavaScriptCallTypesReferenceContributorsProvider"/>
    <paramDefProvider implementation="com.intellij.ruby.javascript.rails.importmap.codeInsight.RailsImportMapParamDefProvider"/>
    <symbolProvider implementation="com.intellij.ruby.javascript.rails.importmap.codeInsight.RailsImportMapSymbolProvider"/>
  </extensions>
</idea-plugin>