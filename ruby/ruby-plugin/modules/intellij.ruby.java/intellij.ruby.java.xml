<idea-plugin>
  <dependencies>
    <module name="intellij.java.backend"/>
    <module name="intellij.ruby.backend"/>
  </dependencies>

  <applicationListeners>
    <listener class="org.jetbrains.plugins.ruby.java.jruby.JRubyProjectJdkTableListener"
              topic="com.intellij.openapi.projectRoots.ProjectJdkTable$Listener"/>
    <listener class="org.jetbrains.plugins.ruby.java.jruby.JRubySdkPathsInitializedListener"
              topic="org.jetbrains.plugins.ruby.ruby.sdk.RubySdkType$SdkPathsInitializedListener"/>
  </applicationListeners>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <callTypeIndexer forClass="org.jetbrains.plugins.ruby.java.jruby.psi.JRubyIncludePackageCallType"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.psi.JRubyIncludePackageCallTypeIndexer"/>
    <callTypeIndexer forClass="org.jetbrains.plugins.ruby.java.jruby.psi.ImportRubyCallType"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.psi.ImportRubyCallTypeIndexer"/>
    <callTypeReferenceContributorsProvider
      implementation="org.jetbrains.plugins.ruby.java.jruby.psi.JRubyCallTypeReferenceContributorsProvider"/>
    <rubyTypeProvider implementation="org.jetbrains.plugins.ruby.java.jruby.types.JRubyTypeProvider"/>
    <symbolProvider implementation="org.jetbrains.plugins.ruby.java.jruby.symbols.JRubySymbolProvider"/>
    <callTypeProvider implementation="org.jetbrains.plugins.ruby.java.jruby.psi.JRubyCallTypeProvider"/>
    <rubySupportProvider implementation="org.jetbrains.plugins.ruby.java.jruby.facet.JRubySupportProvider"/>
    <rubySuperMethodsSearch implementation="org.jetbrains.plugins.ruby.java.jruby.search.JRubySuperMethodSearchExecutor"/>
    <superMethodInfoProvider implementation="org.jetbrains.plugins.ruby.java.jruby.JRubySuperMethodInfoProvider"/>
    <rubyParameterInfoDelegateProvider implementation="org.jetbrains.plugins.ruby.java.jruby.JRubyParameterInfoProvider"/>
    <autoImportProvider implementation="org.jetbrains.plugins.ruby.java.jruby.JRubyAutoImportProvider"/>
    <overriddenMethodGenerator implementation="org.jetbrains.plugins.ruby.java.jruby.JRubyOverriddenMethodGenerator"/>
    <renameHelper implementation="org.jetbrains.plugins.ruby.java.jruby.JRubyRenameHelper"/>
    <completionProvider implementation="org.jetbrains.plugins.ruby.java.jruby.codeInsight.completion.JRubyCompletionProvider"/>

    <railsFacetEditorTab implementation="org.jetbrains.plugins.ruby.java.rails.facet.ui.settings.GeneralSettingsEditorTabFactory"/>
    <gemFacetEditorTab implementation="org.jetbrains.plugins.ruby.java.gem.facet.ui.settings.GemGeneralSettingsEditorTabFactory"/>
    <run.console.filter implementation="org.jetbrains.plugins.ruby.java.run.JRubyStacktraceFilterProvider"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby.ruby.run">
    <runEnvironmentProvider implementation="org.jetbrains.plugins.ruby.java.run.JRubyRunEnvironmentProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <newProjectWizard.languageGenerator implementation="org.jetbrains.plugins.ruby.java.module.RubyNewProjectWizard"/>

    <directoryProjectConfigurator implementation="org.jetbrains.plugins.ruby.java.module.RubyProjectPluginConfigurator"/>

    <applicationConfigurable groupId="language"
                             instance="org.jetbrains.plugins.ruby.java.settings.RubyLanguageSettingsConfigurable"
                             id="ruby"
                             bundle="messages.RBundle"
                             key="ruby.ide.sdk.configurable.name"/>

    <applicationConfigurable groupId="language"
                             parentId="ruby"
                             provider="org.jetbrains.plugins.ruby.java.settings.RubyCodeInsightSettingsConfigurableProvider"
                             id="org.jetbrains.plugins.ruby.java.settings.ruby.RubyCodeInsightSettingsConfigurableProvider"
                             bundle="messages.RBundle"
                             key="ruby.codeInsight.settings.configurable"/>

    <stubIndex implementation="org.jetbrains.plugins.ruby.java.jruby.psi.JRubyImportIndex"/>

    <localInspection language="ruby" shortName="JRubyImplementInterfaceInspection" bundle="messages.RBundle"
                     key="inspection.implement.interface.name"
                     groupKey="inspection.group.jruby.name" enabledByDefault="true" level="ERROR"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.JRubyImplementInterfaceInspection"/>
    <localInspection language="ruby" shortName="JRubyUnusedImportInspection" bundle="messages.RBundle"
                     key="inspection.jruby.unused.import.name"
                     groupKey="inspection.group.jruby.name" enabledByDefault="true" level="WARNING"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.JRubyUnusedImportInspection"/>
    <localInspection language="ruby" shortName="JRubyDeprecatedJavaMethodUsageInspection" bundle="messages.RBundle"
                     key="inspection.jruby.deprecated.java.method.name"
                     groupKey="inspection.group.jruby.name" enabledByDefault="true" level="WARNING"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.JRubyDeprecatedJavaMethodUsageInspection"/>
    <localInspection language="ruby" shortName="WrongTopLevelPackageInspection" bundle="messages.RBundle"
                     key="inspection.wrong.top.level.package"
                     groupKey="inspection.group.jruby.name" enabledByDefault="true" level="ERROR"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.WrongTopLevelPackageInspection"/>
    <localInspection language="ruby" shortName="JRubyStringImportInspection" bundle="messages.RBundle"
                     key="inspection.jruby.string.import.name"
                     groupKey="inspection.group.jruby.name" enabledByDefault="true" level="ERROR"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.JRubyStringImportInspection"/>
    <localInspection language="ruby" shortName="JRubyJavaFieldAccessInspection" bundle="messages.RBundle"
                     key="inspection.jruby.java.field.access.name"
                     groupKey="inspection.group.jruby.name" enabledByDefault="true" level="ERROR"
                     implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.JRubyJavaFieldAccessInspection"/>
    <localInspection language="ruby" shortName="JRubySuperClassMustBeAClassInspection" bundle="messages.RBundle"
                     key="inspection.super.class.must.be.a.class.name" groupKey="inspection.group.jruby.name" enabledByDefault="true"
                     level="ERROR" implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.JRubySuperClassInspection"/>
    <localInspection language="ruby" shortName="JRubyPublicClassInspection" bundle="messages.RBundle"
                     key="inspection.imported.class.should.be.public.name" groupKey="inspection.group.jruby.name" enabledByDefault="true"
                     level="ERROR" implementationClass="org.jetbrains.plugins.ruby.java.jruby.inspections.JRubyPublicClassInspection"/>

    <intentionAction>
      <className>org.jetbrains.plugins.ruby.java.jruby.intentions.JRubyQualifiedNameToImportIntention</className>
      <bundleName>messages.RBundle</bundleName>
      <categoryKey>jruby.intentions.category</categoryKey>
      <language>ruby</language>
    </intentionAction>

    <intentionAction>
      <className>org.jetbrains.plugins.ruby.java.jruby.intentions.JRubyJavaToRubyCallStyleIntention</className>
      <bundleName>messages.RBundle</bundleName>
      <categoryKey>jruby.intentions.category</categoryKey>
      <language>ruby</language>
    </intentionAction>

    <intentionAction>
      <className>org.jetbrains.plugins.ruby.java.jruby.intentions.JRubyStringImportToDotReferenceIntention</className>
      <bundleName>messages.RBundle</bundleName>
      <categoryKey>jruby.intentions.category</categoryKey>
      <language>ruby</language>
    </intentionAction>

    <intentionAction>
      <className>org.jetbrains.plugins.ruby.java.jruby.intentions.JRubyStringImportToCamelReferenceIntention</className>
      <bundleName>messages.RBundle</bundleName>
      <categoryKey>jruby.intentions.category</categoryKey>
      <language>ruby</language>
    </intentionAction>

    <codeInsight.implementMethod language="ruby"
                                 implementationClass="org.jetbrains.plugins.ruby.java.jruby.codeInsight.implement.JRubyImplementHandler"/>

    <moduleType id="RUBY_MODULE" implementationClass="org.jetbrains.plugins.ruby.java.module.RubyModuleType"/>
    <moduleConfigurationEditorProvider implementation="org.jetbrains.plugins.ruby.java.module.RModuleConfigurationEditorProvider"/>
    <projectStructureDetector implementation="org.jetbrains.plugins.ruby.java.module.RubyProjectStructureDetector"/>

    <debugger.nodeRenderer implementation="org.jetbrains.plugins.ruby.java.jruby.debug.ui.JRubyNodeRenderer"/>
    <debugger.javaBreakpointHandlerFactory implementation="org.jetbrains.plugins.ruby.java.jruby.debug.JRubyBreakpointHandlerFactory"/>
    <debugger.positionManagerFactory implementation="org.jetbrains.plugins.ruby.java.jruby.debug.JRubyPositionManager$Factory"/>

    <facetType implementation="org.jetbrains.plugins.ruby.java.jruby.facet.JRubyFacetType"/>
    <facetType implementation="org.jetbrains.plugins.ruby.java.rails.facet.versions.JRailsFacetType"/>
    <framework.detector implementation="org.jetbrains.plugins.ruby.java.rails.facet.versions.JRailsFacetType$JRailsFrameworkDetector"/>

    <frameworkSupport implementation="org.jetbrains.plugins.ruby.java.rails.facet.versions.JRailsFacetSupportProvider"/>

    <!--
    <frameworkSupport implementation="org.jetbrains.plugins.ruby.rails.facet.versions.RailsFacetSupportProvider"/>
    -->

    <moduleBuilder builderClass="org.jetbrains.plugins.ruby.java.rails.facet.versions.RailsModuleBuilder"/>
    <moduleBuilder builderClass="org.jetbrains.plugins.ruby.java.gem.facet.GemModuleBuilder"/>
    <frameworkSupport implementation="org.jetbrains.plugins.ruby.java.jruby.facet.JRubyFacetProvider"/>

    <methodReferencesSearch implementation="org.jetbrains.plugins.ruby.java.jruby.search.JRubyNamesReferenceSearcher"/>
    <directClassInheritorsSearch implementation="org.jetbrains.plugins.ruby.java.jruby.search.JRubyClassInheritorsSearcher"/>
    <overridingMethodsSearch implementation="org.jetbrains.plugins.ruby.java.jruby.search.JRubyOverridingMethodsSearcher"/>
    <allOverridingMethodsSearch implementation="org.jetbrains.plugins.ruby.java.jruby.search.JRubyAllOverridingMethodsSearcher"/>
    <useScopeOptimizer implementation="org.jetbrains.plugins.ruby.java.jruby.search.JRubyUseScopeOptimizer"/>

    <typeDeclarationProvider implementation="org.jetbrains.plugins.ruby.java.jruby.types.JRubyTypeDeclarationProvider"/>

    <!-- Console filters -->
    <consoleFilterProvider implementation="org.jetbrains.plugins.ruby.java.run.JRubyStacktraceFilterProvider"/>
  </extensions>

  <actions resource-bundle="messages.ActionsBundle">
    <action id="Ruby.CreateNewClassFile" class="org.jetbrains.plugins.ruby.ruby.actions.RubyCreateClassFileAction">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="FileTemplateSeparatorGroup"/>
    </action>
    <action id="GemRequirements.ShowSettings" class="org.jetbrains.plugins.ruby.java.gem.ShowModuleSettings"/>
    <action id="InsertRubyInjection"
            class="org.jetbrains.plugins.ruby.ruby.actions.editor.InsertRubyInjectionAction">
      <add-to-group group-id="ScriptsErb"/>
    </action>
    <action id="InsertRubyInjectionWithoutOutput"
            class="org.jetbrains.plugins.ruby.ruby.actions.editor.InsertRubyInjectionWithoutOutputAction">
      <add-to-group group-id="ScriptsErb"/>
    </action>
  </actions>
</idea-plugin>
