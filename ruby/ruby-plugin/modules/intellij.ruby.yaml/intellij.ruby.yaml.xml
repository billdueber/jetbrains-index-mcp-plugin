<idea-plugin>
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.ruby.backend"/>
    <module name="intellij.yaml"/>
    <!-- endregion -->
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <fileBasedIndex implementation="org.jetbrains.plugins.ruby.i18n.indexes.I18nYAMLTranslationIndex"/>
    <fileBasedIndex implementation="org.jetbrains.plugins.ruby.i18n.indexes.I18nYAMLPossibleLocaleIndex"/>
    <fileBasedIndex implementation="org.jetbrains.plugins.ruby.i18n.indexes.I18nTranslationKeysIndex"/>
    <fileBasedIndex implementation="org.jetbrains.plugins.ruby.rails.fixtures.indexes.YamlTopLevelKeysIndex"/>
    <itemPresentationProvider forClass="org.jetbrains.yaml.psi.YAMLKeyValue"
                              implementationClass="org.jetbrains.plugins.ruby.i18n.findUsages.I18nYAMLItemPresentationProvider"/>

    <lang.documentationProvider language="yaml"
                                implementationClass="org.jetbrains.plugins.ruby.i18n.I18nDocumentationProvider"/>

    <annotator language="yaml" implementationClass="org.jetbrains.plugins.ruby.i18n.annotator.I18nYAMLAnnotator"/>
    <lang.findUsagesProvider language="yaml" order="before yamlFindUsagesProvider"
                             implementationClass="org.jetbrains.plugins.ruby.i18n.findUsages.I18nYAMLFindUsagesProvider"/>

    <!-- Rails I18n -->
    <elementDescriptionProvider implementation="org.jetbrains.plugins.ruby.i18n.findUsages.I18nElementDescriptionProvider"/>
    <usageTargetProvider implementation="org.jetbrains.plugins.ruby.i18n.findUsages.YamlFakeUsageTargetProvider"/>

    <lang.substitutor language="TEXT" implementationClass="org.jetbrains.plugins.ruby.psi.BundlerConfigLanguageSubstitutor"/>
    <lang.substitutor language="yaml" implementationClass="org.jetbrains.plugins.ruby.rails.psi.RailsYamlLanguageSubstitutor"/>
    <completion.contributor id="id-RailsFixturesCompletionContributor"
                            order="last"
                            language="ruby"
                            implementationClass="org.jetbrains.plugins.ruby.rails.fixtures.codeInsight.completion.RailsFixturesCompletionContributor"/>
    <completion.contributor language="yaml"
                            implementationClass="org.jetbrains.plugins.ruby.rails.fixtures.codeInsight.completion.RailsYamlFixturesCompletionContributor"/>
    <psi.referenceContributor language="ruby"
                              implementation="org.jetbrains.plugins.ruby.rails.fixtures.references.RailsFixturesReferenceContributor"/>
    <psi.referenceContributor language="yaml"
                              implementation="org.jetbrains.plugins.ruby.rails.fixtures.references.RailsYamlFixturesReferenceContributor"/>
    <lang.findUsagesProvider language="yaml" order="before yamlFindUsagesProvider"
                             implementationClass="org.jetbrains.plugins.ruby.rails.fixtures.findUsages.RailsYamlFixturesRecordFindUsagesProvider"/>
    <renameInputValidator
      implementation="org.jetbrains.plugins.ruby.rails.fixtures.refactoring.rename.RailsYamlFixturesRecordRenameInputValidator"
      order="first"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <gem.detector language="yaml" implementationClass="org.jetbrains.plugins.ruby.gem.detector.DatabaseGemDetector" />

    <i18n.i18nProvider language="yaml" implementationClass="org.jetbrains.plugins.ruby.i18n.YamlI18nProvider" />
    <callTypeIndexer forClass="org.jetbrains.plugins.ruby.rails.fixtures.codeInsight.callTypes.RailsFixturesCallType"
                     implementationClass="org.jetbrains.plugins.ruby.rails.fixtures.codeInsight.callTypes.RailsFixturesCallTypeIndexer"/>
    <callTypeProvider implementation="org.jetbrains.plugins.ruby.rails.fixtures.codeInsight.callTypes.RailsFixturesCallTypeProvider"/>
    <paramDefProvider implementation="org.jetbrains.plugins.ruby.rails.fixtures.codeInsight.paramDef.RailsFixturesParamDefProvider"/>
  </extensions>
</idea-plugin>
