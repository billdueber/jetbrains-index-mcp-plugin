<idea-plugin>
  <dependencies>
    <module name="intellij.platform.coverage"/>
    <module name="intellij.ruby.backend"/>
  </dependencies>

  <!--<resource-bundle xmlns="">org.jetbrains.plugins.ruby.RBundle</resource-bundle>-->

  <extensions defaultExtensionNs="com.intellij">
    <coverageEngine implementation="org.jetbrains.plugins.ruby.coverage.RubyCoverageEngine"/>
    <coverageRunner implementation="org.jetbrains.plugins.ruby.coverage.RCovRunner" order="first"/>

    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.coverage.RubyCoverageDeserializationService"/>

    <projectService serviceImplementation="org.jetbrains.plugins.ruby.coverage.RubyCoverageAnnotator"/>
    <projectService serviceImplementation="org.jetbrains.plugins.ruby.coverage.run.RubyCoverageSuiteListener"/>
    <programRunner implementation="org.jetbrains.plugins.ruby.coverage.RubyCoverageRunner"/>

    <notificationGroup id="RCov.Notification" displayType="BALLOON" bundle="messages.RCovBundle" key="rcov.notification.group"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <runConfigurationExtension implementation="org.jetbrains.plugins.ruby.coverage.run.RubyCoverageRunConfigurationExtension"/>
    <coverage.deserializer implementation="org.jetbrains.plugins.ruby.coverage.SimpleCovJSONDeserializationProvider"/>
    <coverage.deserializer implementation="org.jetbrains.plugins.ruby.coverage.SimpleCovYAMLDeserializationProvider"/>
  </extensions>

  <extensionPoints>
    <extensionPoint qualifiedName="org.jetbrains.plugins.ruby.coverage.deserializer"
                    interface="org.jetbrains.plugins.ruby.coverage.RubyCoverageDeserializationProvider" dynamic="true"/>

  </extensionPoints>
</idea-plugin>
