<idea-plugin>
  <dependencies>
    <plugin id="org.jetbrains.plugins.slim"/>
    <module name="intellij.ruby.backend"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <stubElementTypeHolder class="org.jetbrains.plugins.slim.ruby.psi.SlimRubyOuterLanguageProvider"/>
    <slim.injected.ast.factory implementation="org.jetbrains.plugins.slim.ruby.psi.SlimRubyOuterLanguageProvider"/>
    <lang.fileViewProviderFactory language="Slim" implementationClass="org.jetbrains.plugins.slim.ruby.psi.SlimRubyFileViewProviderFactory"/>

    <highlightErrorFilter implementation="org.jetbrains.plugins.slim.ruby.psi.SlimRubyErrorFilter"/>

    <codeInsight.lineMarkerProvider language="Slim"
                                    implementationClass="org.jetbrains.plugins.ruby.rails.codeInsight.daemon.RailsViewActionLineMarkerProvider"/>

    <embeddedTokenTypesProvider implementation="org.jetbrains.plugins.slim.ruby.RubySlimTokenTypesProvider"/>
    <lang.syntaxHighlighter language="Slim" implementationClass="org.jetbrains.plugins.slim.ruby.RubySlimSyntaxHighlighter" id="rubySlim" order="before plainSlim"/>

    <lang.foldingBuilder language="Slim" implementationClass="org.jetbrains.plugins.ruby.i18n.folding.I18nFoldingBuilder"/>

    <internalFileTemplate name="Slim File"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <templates.integration implementation="org.jetbrains.plugins.slim.ruby.RubySlimIntegrationImpl"/>
    <templates.elements.provider implementation="org.jetbrains.plugins.slim.ruby.RubySlimElementsProviderImpl"/>
    <rails.viewFileTypesProvider implementation="org.jetbrains.plugins.slim.ruby.rails.SlimRailsViewFileTypesProvider"/>
    <rails.viewFileTemplateProvider implementation="org.jetbrains.plugins.slim.ruby.rails.templates.SlimRailsViewFileTemplateProvider"/>
    <psiElementFactory implementation="org.jetbrains.plugins.slim.ruby.RubySlimPsiElementFactory" order="before rubyPsiElementFactory"/>
    <rubyBuilderFactory implementation="org.jetbrains.plugins.slim.ruby.RubySlimBuilderFactory"/>
  </extensions>
</idea-plugin>
