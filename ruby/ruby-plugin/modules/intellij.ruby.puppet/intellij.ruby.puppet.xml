<idea-plugin>
  <dependencies>
    <plugin id="com.intellij.lang.puppet"/>
    <module name="intellij.ruby.puppet.shared"/>
    <module name="intellij.ruby.backend"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <directoryProjectGenerator implementation="com.intellij.lang.puppet.ruby.ide.project.PuppetProjectGenerator" order="after railsApi"/>
    <fileType name="Ruby" fileNamesCaseInsensitive="Puppetfile"/>

    <!-- EPP Extensions -->
    <fileType implementationClass="com.intellij.lang.puppet.ruby.epp.EppFileType"
              name="EPP file" extensions="epp" language="Embedded Puppet"/>
    <lang.fileViewProviderFactory language="Embedded Puppet" implementationClass="com.intellij.lang.puppet.ruby.epp.EppFileViewProviderFactory"/>
    <lang.parserDefinition language="Embedded Puppet" implementationClass="com.intellij.lang.puppet.ruby.epp.EppParserDefinition"/>
    <editorHighlighterProvider filetype="EPP file" implementationClass="com.intellij.lang.puppet.ruby.epp.ide.EppHighlighterProvider"/>
    <lang.braceMatcher language="Embedded Puppet" implementationClass="com.intellij.lang.puppet.ruby.epp.ide.EppBraceMatcher"/>
    <typedHandler implementation="com.intellij.lang.puppet.ruby.epp.ide.editor.EppTypedHandler"/>
    <backspaceHandlerDelegate implementation="com.intellij.lang.puppet.ruby.epp.ide.editor.EppBackSpaceHandler"/>
    <psi.referenceContributor language="Puppet" implementation="com.intellij.lang.puppet.ruby.epp.psi.references.EppReferenceContributor"/>
    <completion.contributor language="Puppet" implementationClass="com.intellij.lang.puppet.ruby.epp.ide.EppCompletionContributor"/>
    <!-- EPP Extensions end -->

    <notificationGroup id="PUPPET_ERROR" displayType="BALLOON" bundle="messages.PuppetBundle" key="error.notification.group"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <gemScannerSuppressor implementation="com.intellij.lang.puppet.ruby.gem.PuppetGemScannerSuppressor"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij.puppet">
    <dependencyManagerAdapter order="before default" id="librarianRuby"
                              implementation="com.intellij.lang.puppet.ruby.adapters.PuppetLibrarianGemAdapter"/>
    <dependencyManagerAdapter order="before librarianRuby"
                              implementation="com.intellij.lang.puppet.ruby.adapters.PuppetFixturesDependenciesAdapter"/>
  </extensions>

  <actions resource-bundle="messages.PuppetBundle">
    <action id="Puppet.CreateModule"
            class="com.intellij.lang.puppet.ruby.CreatePuppetModuleAction"
            icon="com.intellij.lang.puppet.PuppetIcons.PuppetLogo">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="Rails.RunGenerator"/>
    </action>
  </actions>
</idea-plugin>