<idea-plugin>

  <dependencies>
    <module name="intellij.profiler.asyncOne"/>
    <module name="intellij.profiler.common"/>
    <module name="intellij.ruby.backend"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <profiler.api.attachProfilerProvider implementation="com.intellij.profiler.ruby.RbSpyLocalAttachProfilerProvider"/>

    <programRunner implementation="com.intellij.profiler.ruby.RubyProfilerRunner"/>
    <profiler.api.ProfilerDumpParserProvider implementation="com.intellij.profiler.ruby.RbSpyProfilerDumpParserProvider"/>

    <profiler.profilerConfigurationType
        implementation="com.intellij.profiler.ruby.configuration.RbSpyConfigurationType"/>

    <applicationConfigurable parentId="profiler"
                             id="profiler.ruby"
                             bundle="messages.RubyProfilerBundle"
                             key="profiler.ruby.configurable.name"
                             provider="com.intellij.profiler.ruby.configuration.RubyProfilerConfigurableProvider"/>
    <notificationGroup id="Ruby Profiler" displayType="BALLOON" bundle="messages.RubyProfilerBundle"
                       key="profiler.ruby.notification.group.name"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <runConfigurationExtension implementation="com.intellij.profiler.ruby.RbSpyProfilerConfigurationExtension" order="before ruby.bundler"/>
  </extensions>

</idea-plugin>
