<idea-plugin visibility="public">
  <dependencies>
    <module name="intellij.ruby"/>
    <module name="intellij.ruby.psi"/>
  </dependencies>
  <extensionPoints>
    <extensionPoint qualifiedName="org.jetbrains.plugins.ruby.templates.elements.provider"
                    interface="org.jetbrains.plugins.ruby.templates.TemplateElementsProvider"
                    dynamic="true"/>
    <extensionPoint qualifiedName="org.jetbrains.plugins.ruby.formatter.additionalSpacingProcessor"
                    interface="org.jetbrains.plugins.ruby.ruby.lang.formatter.processors.RubyAdditionalSpacingProcessor" dynamic="true"/>
    <extensionPoint qualifiedName="org.jetbrains.plugins.ruby.rubyBuilderFactory"
                    interface="org.jetbrains.plugins.ruby.ruby.lang.parser.RubyBuilderFactory"
                    dynamic="true"/>
    <extensionPoint qualifiedName="org.jetbrains.plugins.ruby.psiElementFactory"
                    interface="org.jetbrains.plugins.ruby.ruby.lang.parser.PsiElementFactory"
                    dynamic="true"/>
    <extensionPoint qualifiedName="org.jetbrains.plugins.ruby.settings.supportedExternalFormatter"
                    interface="org.jetbrains.plugins.ruby.settings.RubySupportedExternalFormatter"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="org.jetbrains.plugins.ruby.ruby.actions.editor.RubyEditorOptions" client="all"/>
    <applicationSettings service="org.jetbrains.plugins.ruby.ruby.actions.editor.RubyEditorOptions"/>

    <fileType name="Ruby" implementationClass="org.jetbrains.plugins.ruby.ruby.lang.RubyFileType" fieldName="RUBY"
              language="ruby"
              extensions="gemspec;jbuilder;rake;rb;rbi;rbw;ru;thor"
              hashBangs="ruby"
              fileNamesCaseInsensitive="rakefile;gemfile;capfile;guardfile;vagrantfile;.simplecov;steepfile"/>
    <fileType name="Rjs" extensions="rjs" fieldName="RJS"
              implementationClass="org.jetbrains.plugins.ruby.rails.langs.RJSFileType"/>
    <fileType name="RbenvGemsets" fileNamesCaseInsensitive=".rbenv-gemsets;.ruby-gemset" language="rbenv-gemsets"
              fieldName="RBENV_GEMSETS_FILE_TYPE"
              implementationClass="org.jetbrains.plugins.ruby.version.management.rbenv.gemsets.RbenvGemsetsFileType"/>
    <fileType name="RXML" extensions="builder;rxml" fieldName="RXML"
              implementationClass="org.jetbrains.plugins.ruby.rails.langs.RXMLFileType"/>
    <fileType name="JSON" language="JSON" fileNames="brakeman.ignore"/>
    <fileType name="ERB" extensions="erb;rhtml" language="ERB" fieldName="ERB"
              implementationClass="org.jetbrains.plugins.ruby.erb.ErbFileType"/>
    <lang.syntaxHighlighter language="ruby"
                            implementationClass="org.jetbrains.plugins.ruby.ruby.lang.highlighter.RubySyntaxHighlighter"/>
    <lang.braceMatcher language="ruby" implementationClass="org.jetbrains.plugins.ruby.ruby.lang.braceMatcher.RubyPairedBraceMatcher"/>
    <basicWordSelectionFilter implementation="org.jetbrains.plugins.ruby.ruby.actions.editor.RubyWordSelectionFilter"/>
    <lang.commenter language="ruby" implementationClass="org.jetbrains.plugins.ruby.ruby.lang.commenter.RubyCommenter"/>
    <backspaceHandlerDelegate implementation="org.jetbrains.plugins.ruby.ruby.actions.editor.handlers.RubyBackspaceHandler"
                              order="after SmartIndentingBackspaceHandler"/>
    <editorSmartKeysConfigurable instance="org.jetbrains.plugins.ruby.ruby.actions.editor.RubySmartKeysConfigurable"
                                 id="editor.preferences.rubyOptions"
                                 bundle="messages.RubyCommonBundle" key="configurable.RubyEditorOptionsProvider.display.name"/>
    <editorAppearanceConfigurable instance="org.jetbrains.plugins.ruby.ruby.actions.editor.RubyEditorAppearanceConfigurable"/>
    <enterHandlerDelegate id="RubyEnterHandler" implementation="org.jetbrains.plugins.ruby.ruby.actions.editor.handlers.RubyEnterHandler"
                          order="before EnterBetweenBracesHandler"/>
    <lang.tokenSeparatorGenerator language="ruby"
                                  implementationClass="org.jetbrains.plugins.ruby.ruby.lang.psi.RubyTokenSeparatorGenerator"/>
    <editorActionHandler action="EditorStartNewLine" id="RubyShiftEnterCommentHandler" order="first"
                         implementationClass="org.jetbrains.plugins.ruby.ruby.actions.editor.handlers.RubyEnterHandler$RubyShiftEnterCommentHandler"/>
    <typedHandler implementation="org.jetbrains.plugins.ruby.ruby.actions.editor.handlers.RubyTypedHandler"/>
    <extendWordSelectionHandler implementation="org.jetbrains.plugins.ruby.ruby.actions.editor.RubyWordSelectionHandler"/>
    <extendWordSelectionHandler implementation="org.jetbrains.plugins.ruby.ruby.actions.editor.RubyCommentsSelectionHandler"/>
    <extendWordSelectionHandler implementation="org.jetbrains.plugins.ruby.ruby.actions.editor.RubyStatementSelectionHandler"/>
    <lang.formatter language="ruby" implementationClass="org.jetbrains.plugins.ruby.ruby.lang.formatter.RubyFormattingModelBuilder"/>
    <langCodeStyleSettingsProvider implementation="org.jetbrains.plugins.ruby.ruby.lang.formatter.RubyLanguageCodeStyleSettingsProvider"/>
    <codeStyleSettingsProvider implementation="org.jetbrains.plugins.ruby.settings.RubyCodeStyleSettingsProvider"/>
    <editorHighlighterProvider filetype="Ruby"
                               implementationClass="org.jetbrains.plugins.ruby.ruby.lang.highlighter.RubyEditorHighlighterProvider"/>
    <colorSettingsPage implementation="org.jetbrains.plugins.ruby.ruby.lang.highlighter.RubyColorsPage"/>
    <codeBlockSupportHandler language="ruby"
                             implementationClass="org.jetbrains.plugins.ruby.ruby.codeInsight.highlighting.RubyCodeBlockSupportHandler"/>
    <lang.quoteHandler language="ruby" implementationClass="org.jetbrains.plugins.ruby.ruby.actions.editor.handlers.RubyQuoteHandler"/>
    <lang.quoteHandler language="ERB" implementationClass="org.jetbrains.plugins.ruby.ruby.actions.editor.handlers.RubyQuoteHandler"/>

    <rdct.remoteSettingProvider implementation="org.jetbrains.plugins.ruby.settings.RubyRemoteSettingInfoProvider"/>

    <!--RDoc-->
    <fileType name="RDOC" extensions="rdoc" fileNames="readme" language="RDOC" fieldName="RDOC"
              implementationClass="org.jetbrains.plugins.ruby.rdoc.RDocFileType" />
    <colorSettingsPage implementation="org.jetbrains.plugins.ruby.rdoc.RDocColorsPage"/>
    <lang.syntaxHighlighter language="RDOC" implementationClass="org.jetbrains.plugins.ruby.rdoc.RDocSyntaxHighlighter"/>
    <lang.parserDefinition language="RDOC" implementationClass="org.jetbrains.plugins.ruby.rdoc.RDocParserDefinition"/>
  </extensions>
</idea-plugin>