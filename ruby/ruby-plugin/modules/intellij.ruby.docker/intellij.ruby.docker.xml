<idea-plugin>
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.clouds.docker.agent"/>
    <module name="intellij.clouds.docker.remoteRun"/>
    <module name="intellij.ruby.backend"/>
    <module name="intellij.ruby.coverage"/>
    <module name="intellij.ruby.remoteInterpreter"/>
    <!-- endregion -->
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <remote.credentialsLanguageContribution implementation="com.intellij.docker.remote.ruby.DockerCredentialsRubyContribution"/>
    <remote.credentialsLanguageContribution implementation="com.intellij.docker.remote.ruby.compose.DockerComposeCredentialsRubyContribution"/>

    <docker.remote.dockerCredentialsEditorLanguageContribution
      implementation="com.intellij.docker.remote.ruby.DockerCredentialsEditorRubyContribution"/>
    <docker.remote.dockerComposeCredentialsEditorLanguageContribution
      implementation="com.intellij.docker.remote.ruby.compose.DockerComposeCredentialsEditorRubyContribution"/>

    <remote.pathMappingProvider implementation="com.intellij.docker.remote.ruby.RubyDockerMappingsProvider"/>
    <remote.pathMappingProvider implementation="com.intellij.docker.remote.ruby.compose.RubyDockerComposeMappingsProvider"
                                order="before pyDockerComposePathMappingProvider"/>
    <registryKey key="ruby.docker.debugger.max.supported.child.processes"
                 description="Maximum supported number of child processes of an application for debugging in a Docker container"
                 defaultValue="32"/>
    <registryKey key="ruby.docker.compose.command.by.default" defaultValue="run"
                 description="docker-compose command to perform task in container (up, exec or run)"/>
    <registryKey key="ruby.docker.compose.rails.command.by.default" defaultValue="up"
                 description="docker-compose command to launch Rails server (up, exec or run)"/>

    <!-- Requires restart, because RubyGemsEnvironment is cached (see com.intellij.docker.remote.ruby.RubyDockerBaseSdkConfigurator). -->
    <registryKey key="ruby.docker.use.proprietary.debase.debugger"
                 defaultValue="true"
                 description="Allows IDE to use the JetBrains proprietary debase debugger backend with Docker SDK"/>

    <projectConfigurable parentId="Docker"
                         instance="com.intellij.docker.remote.ruby.settings.RubyDockerConfigurable"
                         id="ruby.docker.id"
                         key="configurable.name"
                         bundle="messages.RubyDockerBundle"
                         nonDefaultProject="true"/>

    <applicationService serviceImplementation="com.intellij.docker.remote.ruby.settings.RubyDockerSettings"/>

    <registryKey key="ruby.docker.verbose.logging" defaultValue="false" description="Enables verbose logging for Ruby Docker integration"/>
    <applicationSettings service="com.intellij.docker.remote.ruby.settings.RubyDockerSettings"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.plugins.ruby">
    <rubySdkConfigurator implementation="com.intellij.docker.remote.ruby.RubyDockerSdkConfigurator"/>
    <runConfigurationExtension implementation="com.intellij.docker.remote.ruby.run.RubyDockerRunConfigurationExtension"/>

    <rubySdkConfigurator implementation="com.intellij.docker.remote.ruby.compose.RubyDockerComposeSdkConfigurator"/>
    <ruby.run.configuration.debugger.rubyDebugHelperFactory implementation="com.intellij.docker.remote.ruby.RubyDockerDebugHelperFactory"
                                                            order="before rubyDebugIdeHelperFactory"/>
    <runConfigurationExtension implementation="com.intellij.docker.remote.ruby.coverage.RubyDockerCoverageRunConfigurationExtension"
                               order="first"/>
  </extensions>
</idea-plugin>
